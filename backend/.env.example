# FIT23Hub backend configuration.
# Copy to .env and fill in real values. Never commit a filled-in .env.

NODE_ENV=development
PORT=4000

# --- Database (PostgreSQL) ---
# In production use the pooled connection string for DATABASE_URL and the
# direct one for DIRECT_URL (migrations only).
DATABASE_URL=postgresql://user:password@localhost:5432/fit23hub
DIRECT_URL=postgresql://user:password@localhost:5432/fit23hub

# --- Auth ---
# Must be at least 32 characters in production.
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars
# There is no refresh token, so this alone bounds how long a leaked token stays
# valid. Kept short deliberately; earlier revocation (password change, an
# admin suspension, "sign out everywhere") works independently of this via the
# user's tokenVersion column and takes effect immediately regardless of it.
JWT_EXPIRES_IN=1d

# --- Platform owner (super admin) ---
# This account always holds the SUPER_ADMIN role: it is re-asserted on every
# boot, so it can never be demoted or suspended from inside the app. Only the
# super admin can grant or revoke admin access to others.
# If the account does not exist yet it is created; leave the password blank to
# generate a random one and set it via "Forgot password".
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_NAME=Platform Owner
SUPER_ADMIN_INDEX=SUPER-ADMIN
SUPER_ADMIN_PASSWORD=

# --- Optional break-glass admin (created on backend boot) ---
# Email must be @uom.lk; password needs upper/lower/digit/symbol, 10-72 chars.
ADMIN_EMAIL=admin@uom.lk
ADMIN_PASSWORD=ChangeThisAdmin1!

# --- Uploads ---
# local = store on disk under backend/uploads
# s3 = Amazon S3 (production on AWS; see deploy/AWS.md)
# supabase = Supabase object storage
STORAGE_DRIVER=local

# S3. On EC2, leave the access keys unset: the instance's IAM role is used.
S3_BUCKET=
AWS_REGION=ap-south-1
# A CloudFront domain in front of the bucket, if you add one.
S3_PUBLIC_URL=
# Only for S3-compatible stores such as MinIO in local testing.
S3_ENDPOINT=

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=fit23hub-assets

# --- Session cache (Redis) ---
# requireAuth re-reads the user on every request; this caches that row briefly.
# Leave blank and the cache lives in the process, which is fine for a single
# instance. With more than one instance you MUST set this: otherwise suspending
# an account only takes effect on whichever process handled the request, and the
# others keep serving a cached "active" row until their own copy expires.
# If Redis is configured but unreachable, caching is skipped entirely (every
# request reads the database) rather than silently falling back to per-process
# memory, which would reintroduce that staleness invisibly.
REDIS_URL=
AUTH_CACHE_TTL_SECONDS=15

# --- Session cookie ---
# The JWT is delivered in an httpOnly cookie, so page scripts cannot read it.
# "lax" is correct when the site and API share a registrable domain, including
# localhost on different ports. Deploying the frontend and backend to genuinely
# different domains (e.g. Vercel + Render) needs "none", which browsers only
# accept together with COOKIE_SECURE=1 over HTTPS.
COOKIE_SAMESITE=lax
# Defaults to 1 when NODE_ENV=production.
COOKIE_SECURE=
# Only set when the API and site share a parent domain (e.g. .fit23hub.lk).
COOKIE_DOMAIN=

# --- Frontend origin ---
CORS_ORIGIN=http://localhost:3000
APP_URL=http://localhost:3000
TRUST_PROXY=0

# --- Outgoing mail (password reset + email verification) ---
# Leave SMTP_* blank in development to fall back to an Ethereal test inbox
# (no real delivery; a preview URL is printed in the backend log).
MAIL_FROM="FIT23Hub <no-reply@fit23hub.local>"
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
PASSWORD_RESET_TTL_MINUTES=60
EMAIL_VERIFY_TTL_MINUTES=1440

# --- AI providers ---
# NOTE: model ids drift often. If a call 404s with "model does not
# exist", list the live ids: curl <base>/models -H "Authorization: Bearer <key>"
# and update the *_MODEL_* var - no code change needed.
# The assistant tries providers in this order: groq -> gemini -> openrouter ->
# cerebras -> huggingface. A provider is only used when its key is set, so you
# can start with one and add more later. With no keys at all the assistant
# still works: it degrades to showing the matching source snippets.
GROQ_API_KEY=
GROQ_MODEL_CHAT=openai/gpt-oss-20b
GROQ_MODEL_ARTIFACT=openai/gpt-oss-120b

GEMINI_API_KEY=
GEMINI_MODEL_CHAT=gemini-flash-lite-latest
GEMINI_MODEL_ARTIFACT=gemini-flash-lite-latest

OPENROUTER_API_KEY=
OPENROUTER_MODEL_CHAT=google/gemma-4-31b-it:free
OPENROUTER_MODEL_ARTIFACT=google/gemma-4-31b-it:free

# Optional extra providers - adapters exist but stay off unless keyed.
CEREBRAS_API_KEY=
HF_API_KEY=

# --- AI tuning ---
AI_REQUEST_TIMEOUT_MS=12000
AI_PROVIDER_COOLDOWN_MS=60000
AI_CACHE_TTL_MS=1800000
AI_CACHE_MAX_ENTRIES=500
AI_USER_DAILY_CHAT_LIMIT=40
AI_USER_DAILY_ARTIFACT_LIMIT=15

# --- Rate limiting ---
# Signed-in requests are counted per student, not per IP: the whole batch can
# share one campus NAT address, and a per-IP budget would be shared by all of
# them. Only signed-out requests (sign-in, registration, recovery) are counted
# per IP, and that ceiling is sized for several hundred students signing in at
# once. Password guessing is stopped by the per-account limit instead.
RATE_LIMIT_WINDOW_MS=900000
# Per signed-in student, per window.
API_RATE_LIMIT_MAX=600
AI_RATE_LIMIT_MAX=60
# Per IP, signed-out requests only.
AUTH_RATE_LIMIT_MAX=1000
# Per account (the email being tried, or the signed-in student): sign-in,
# forgot-password, resend-verification, change-password, delete-account.
AUTH_ACCOUNT_RATE_LIMIT_MAX=10

# --- Embeddings-backed retrieval ---
# Reuses GEMINI_API_KEY. Without it, retrieval stays keyword-only and the
# assistant still works - chunks simply score on keyword overlap alone.
GEMINI_EMBED_MODEL=gemini-embedding-001
AI_EMBED_TIMEOUT_MS=10000
# How much of the hybrid score comes from vector similarity (rest is keyword).
AI_VECTOR_WEIGHT=0.6
