generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  STUDENT
  ADMIN
  SUPER_ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum NotificationType {
  WELCOME
  MATERIAL_UPLOADED
  RECORDING_PUBLISHED
  LIVE_SCHEDULED
  LIVE_STARTED
  ACCOUNT_SUSPENDED
  ACCOUNT_REACTIVATED
  ROLE_CHANGED
  PASSWORD_CHANGED
  NEW_STUDENT_JOINED
  ACCOUNT_DELETED
  ANNOUNCEMENT_POSTED
}

enum AnnouncementCategory {
  GENERAL
  EXAM
  DEADLINE
  SCHEDULE_CHANGE
  EVENT
  RESOURCE
}

enum MaterialCategory {
  NOTES
  LECTURE_SLIDES
  LAB_SHEETS
  TUTORIALS
  PAPERS_AND_ANSWERS
}

model User {
  id           String            @id @default(cuid())
  fullName     String
  indexNo      String
  email        String            @unique
  passwordHash String
  profileImageUrl String?
  role         UserRole          @default(STUDENT)
  status       UserStatus        @default(ACTIVE)
  suspensionReason String?
  emailVerifiedAt DateTime?
  isSystemAccount Boolean          @default(false)
  deletedAt    DateTime?
  deletedById  String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  materials    Material[]        @relation("MaterialUploader")
  archivedMaterials Material[]   @relation("MaterialArchivedBy")
  recordings   RecordedSession[]
  liveSessions LiveSession[]
  aiQueries    AiQueryLog[]
  aiProjects   AiProject[]
  aiSources    AiSource[]
  aiChats      AiChat[]
  passwordResets PasswordResetToken[]
  emailVerifications EmailVerificationToken[]
  notifications Notification[]
  announcements Announcement[]  @relation("AnnouncementAuthor")
  archivedAnnouncements Announcement[] @relation("AnnouncementArchivedBy")
  announcementAcks AnnouncementAck[]

  @@index([role, status])
  @@index([createdAt])
  @@index([deletedAt])
}

model AiProject {
  id          String    @id @default(cuid())
  name        String
  description String?
  userId      String
  user        User      @relation(fields: [userId], references: [id])
  sources     AiSource[]
  chats       AiChat[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([userId, updatedAt])
}

model Material {
  id           String           @id @default(cuid())
  title        String
  module       String           @default("General")
  semester     Int              @default(1)
  academicYear String           @default("Level 1")
  description  String?
  category     MaterialCategory
  fileUrl      String?
  externalUrl  String?
  uploaderId   String
  uploader     User             @relation("MaterialUploader", fields: [uploaderId], references: [id])
  deletedAt    DateTime?
  deletedById  String?
  deletedBy    User?            @relation("MaterialArchivedBy", fields: [deletedById], references: [id])
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@index([deletedAt, createdAt])
  @@index([uploaderId, createdAt])
  @@index([semester, academicYear, createdAt])
  @@index([module, createdAt])
  @@index([category, createdAt])
}

model RecordedSession {
  id          String   @id @default(cuid())
  title       String
  module      String   @default("General")
  semester    Int      @default(1)
  academicYear String  @default("Level 1")
  description String?
  videoUrl    String
  uploaderId  String
  uploader    User     @relation(fields: [uploaderId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([uploaderId, createdAt])
  @@index([semester, academicYear, createdAt])
  @@index([module, createdAt])
}

model LiveSession {
  id          String   @id @default(cuid())
  title       String
  module      String   @default("General")
  semester    Int      @default(1)
  academicYear String  @default("Level 1")
  description String?
  streamUrl   String
  recordingUrl String?
  scheduledFor DateTime?
  isLive      Boolean  @default(false)
  startedAt   DateTime?
  endedAt     DateTime?
  managerId   String
  manager     User     @relation(fields: [managerId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([managerId, createdAt])
  @@index([isLive, scheduledFor])
  @@index([semester, academicYear, createdAt])
  @@index([module, createdAt])
}

model AiQueryLog {
  id        String   @id @default(cuid())
  prompt    String
  response  String
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

model AiSource {
  id           String   @id @default(cuid())
  title        String
  module       String   @default("General")
  semester     Int      @default(1)
  academicYear String   @default("Level 1")
  description  String?
  contentText  String
  fileUrl      String?
  projectId    String?
  project      AiProject? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  uploaderId   String
  uploader     User     @relation(fields: [uploaderId], references: [id])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  chunks       AiSourceChunk[]

  @@index([uploaderId, createdAt])
  @@index([projectId, createdAt])
  @@index([semester, academicYear, createdAt])
  @@index([module, createdAt])
}

model AiChat {
  id        String          @id @default(cuid())
  title     String
  projectId String?
  project   AiProject?      @relation(fields: [projectId], references: [id], onDelete: SetNull)
  userId    String
  user      User            @relation(fields: [userId], references: [id])
  messages  AiChatMessage[]
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@index([userId, updatedAt])
  @@index([projectId, updatedAt])
}

model AiChatMessage {
  id          String   @id @default(cuid())
  chatId       String
  chat         AiChat   @relation(fields: [chatId], references: [id], onDelete: Cascade)
  role         String
  content      String
  citationsJson String?
  createdAt    DateTime @default(now())

  @@index([chatId, createdAt])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, createdAt])
  @@index([expiresAt])
}

model EmailVerificationToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, createdAt])
  @@index([expiresAt])
}

/// A noticeboard post written by an admin. Unlike a Notification it is durable
/// content students browse and come back to, it can carry the date something is
/// due, and it records who has acknowledged it.
model Announcement {
  id          String               @id @default(cuid())
  title       String
  body        String
  category    AnnouncementCategory @default(GENERAL)
  module      String?
  linkUrl     String?
  pinned      Boolean              @default(false)
  /// When the exam sits, the form is due, or the event happens.
  eventAt     DateTime?
  /// Null while the announcement is still a draft.
  publishedAt DateTime?
  /// After this the notice drops off the student board on its own.
  expiresAt   DateTime?
  authorId    String
  author      User                 @relation("AnnouncementAuthor", fields: [authorId], references: [id])
  deletedAt   DateTime?
  deletedById String?
  deletedBy   User?                @relation("AnnouncementArchivedBy", fields: [deletedById], references: [id])
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  acknowledgements AnnouncementAck[]

  @@index([deletedAt, publishedAt])
  @@index([eventAt])
}

model AnnouncementAck {
  id             String       @id @default(cuid())
  announcementId String
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  acknowledgedAt DateTime     @default(now())

  @@unique([announcementId, userId])
  @@index([userId])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  body      String
  link      String?
  actorName String?
  readAt    DateTime?
  createdAt DateTime         @default(now())

  @@index([userId, createdAt])
  @@index([userId, readAt])
}

/// One retrievable slice of an AiSource. The embedding is stored as a JSON
/// array of floats so this works on plain Postgres without the pgvector
/// extension; embedding stays null until the vector is generated, and
/// retrieval falls back to keyword scoring for those rows.
model AiSourceChunk {
  id         String   @id @default(cuid())
  sourceId   String
  source     AiSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  idx        Int
  text       String
  embedding  String?
  embeddedAt DateTime?
  createdAt  DateTime @default(now())

  @@unique([sourceId, idx])
  @@index([sourceId, idx])
  @@index([embeddedAt])
}
