# Production settings for the EC2 server. Copy to deploy/.env.production
# (git-ignored) and fill in. backend/.env.example documents every variable;
# this file only lists what production needs, with production values.

# --- Where the API is reached (used by Caddy for the HTTPS certificate) ---
# Before you own a domain: your Elastic IP with dashes, e.g. 13-201-45-67.sslip.io
# After:                   api.yourdomain.com
API_DOMAIN=13-201-45-67.sslip.io

# --- Database: RDS PostgreSQL ---
# sslmode=require: RDS enforces encrypted connections by default.
DATABASE_URL=postgresql://fit23hub:PASSWORD@your-db.xxxxxx.ap-south-1.rds.amazonaws.com:5432/fit23hub?sslmode=require
DIRECT_URL=postgresql://fit23hub:PASSWORD@your-db.xxxxxx.ap-south-1.rds.amazonaws.com:5432/fit23hub?sslmode=require

# --- Auth ---
# Generate with: openssl rand -hex 48
JWT_SECRET=
JWT_EXPIRES_IN=1d

SUPER_ADMIN_EMAIL=
SUPER_ADMIN_NAME=Platform Owner
SUPER_ADMIN_INDEX=SUPER-ADMIN
SUPER_ADMIN_PASSWORD=
# Leave both blank to skip the break-glass admin in production.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Uploads: S3 ---
# No access keys here: the EC2 instance's IAM role grants access to the bucket.
STORAGE_DRIVER=s3
S3_BUCKET=fit23hub-uploads
AWS_REGION=ap-south-1
# Only if you put CloudFront in front of the bucket.
S3_PUBLIC_URL=

# --- Frontend and cookies ---
# Phase 1 (Vercel URL, API reached through Vercel's rewrites):
#   the browser only ever sees the vercel.app origin, so the defaults work.
APP_URL=https://fit23hub.vercel.app
CORS_ORIGIN=https://fit23hub.vercel.app
COOKIE_SAMESITE=lax
COOKIE_SECURE=1
COOKIE_DOMAIN=
# Phase 2 (own domain, site on yourdomain.com, API on api.yourdomain.com):
#   APP_URL=https://yourdomain.com
#   CORS_ORIGIN=https://yourdomain.com,https://www.yourdomain.com
#   COOKIE_DOMAIN=.yourdomain.com

# --- Session cache ---
# One API container, so the in-process cache is correct. Set this only if
# you run more than one.
REDIS_URL=

# --- Mail (required in production: verification and password reset) ---
# Quickest start: a Gmail account with an app password (500 mails/day).
# With a domain, Amazon SES or Brevo is the better long-term choice.
MAIL_FROM="FIT23Hub <your-address@gmail.com>"
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# --- AI providers (any subset; see backend/.env.example) ---
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
